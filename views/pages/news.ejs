<%- include('../partials/top') %>
<%- include('../partials/band', { kicker: item.tag.toUpperCase(), heading: item.title, sub: item.summary }) %>
<section class="section" style="padding-top: 48px"><div class="container" style="max-width: 820px">
  <p class="dim small"><%= new Date(item.created_at).toISOString().slice(0, 10) %></p>
  <div class="stack" style="gap: 14px">
    <% item.body.split(/\n{2,}/).forEach(p => { %><p class="muted" style="white-space: pre-line"><%= p %></p><% }) %>
  </div>
  <div><a class="btn ghost" href="/news">All news</a></div>
</div></section>
<%- include('../partials/bottom') %>
