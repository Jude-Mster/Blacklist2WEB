# Copy this file to bot/.env and fill it in. Never commit bot/.env.

# From discord.com/developers/applications > your app
DISCORD_TOKEN=
DISCORD_APP_ID=

# Blacklist2 Online server and you (already filled in)
GUILD_ID=1572493263410036767
OWNER_ID=279405521012785153
# Category where private order channels are created (🎟️ GP ORDERS)
ORDERS_CATEGORY_ID=1572668442773946468
# Optional: copy of approvals in #staff-logs (also used if your DMs are closed)
LOG_CHANNEL_ID=1572495129741230140

# Website the codes come from. While testing on your PC: http://localhost:3000
SITE_URL=https://blacklist2.com
# Same value as BOT_API_SECRET in the website's .env (32+ random characters)
BOT_API_SECRET=

# Orders one Discord user can place per 24 hours
MAX_ORDERS_PER_DAY=5
