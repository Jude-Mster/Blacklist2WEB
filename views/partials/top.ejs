<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' && title ? title + ' · ' + site.name : site.name + ' — Classic TwelveSky 2 private server' %></title>
<meta name="description" content="Blacklist TS2 Online: a classic TwelveSky 2 private server for PC and Android. Four factions, one shared world.">
<meta property="og:title" content="<%= site.name %>">
<meta property="og:description" content="Classic TwelveSky 2 on PC and Android. Four factions, one shared world.">
<meta property="og:image" content="<%= site.url %>/img/logo.png">
<meta property="og:url" content="<%= site.url %>">
<meta name="theme-color" content="#0a0608">
<link rel="icon" type="image/png" href="/img/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Uncial+Antiqua&family=Cinzel:wght@500;700;900&family=Inter:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="/css/site.css">
</head>
<body>
<header class="site-header">
  <a class="brand" href="/"><img src="/img/s-icon.png" alt=""><span>Blacklist <b>TS2</b></span></a>
  <nav class="nav" aria-label="Main">
    <% [['/', 'Home'], ['/download', 'Download'], ['/rankings', 'Rankings'], ['/recharge', 'Recharge'], ['/support', 'Support']].forEach(([href, label]) => { %>
      <a href="<%= href %>" class="<%= (href === '/' ? path === '/' : path.startsWith(href)) ? 'on' : '' %>"><%= label %></a>
    <% }) %>
  </nav>
  <div class="row">
    <span class="status"><span class="dot <%= status.online ? 'on' : '' %>"></span><%= status.online ? 'Online' + (status.players != null ? ' · ' + status.players + ' players' : '') : 'Server offline' %></span>
    <% if (user) { %>
      <% if (user.role === 'admin') { %><a class="btn sm ghost" href="/admin">Admin</a><% } %>
      <a class="btn sm ghost" href="/account"><%= user.account_id %></a>
      <form class="inline" method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm ghost" type="submit">Log out</button></form>
    <% } else { %>
      <a class="btn sm ghost" href="/login">Log in</a>
      <a class="btn sm" href="/register">Register</a>
    <% } %>
  </div>
</header>
<% if (typeof admin !== 'undefined' && admin) { %>
<nav class="admin-nav" aria-label="Admin">
  <% [['/admin', 'Dashboard'], ['/admin/orders', 'GCash orders'], ['/admin/credits', 'Coin deliveries'], ['/admin/codes', 'Codes'], ['/admin/resellers', 'Resellers'], ['/admin/packs', 'Packs'], ['/admin/news', 'News'], ['/admin/users', 'Users']].forEach(([href, label]) => { %>
    <a href="<%= href %>" class="<%= (href === '/admin' ? (path === '/admin' || path === '/admin/') : path.startsWith(href)) ? 'on' : '' %>"><%= label %></a>
  <% }) %>
</nav>
<% } %>
<% if (flashes.length) { %>
<div class="flashes" role="status">
  <% flashes.forEach(f => { %><div class="alert <%= f.type %>"><%= f.text %></div><% }) %>
</div>
<% } %>
<main>
