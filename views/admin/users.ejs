<%- include('../partials/top') %>
<section class="section" style="padding-top: 40px"><div class="container">
  <h1 class="display" style="font-size: 40px">Users</h1>
  <form class="row" method="get" action="/admin/users"><input type="text" name="q" value="<%= q %>" placeholder="Account ID or email" style="max-width: 360px"><button class="btn ghost" type="submit">Search</button></form>
  <div class="table-wrap"><table>
    <thead><tr><th>#</th><th>Account</th><th>Email</th><th>Role</th><th>Joined</th><th>Last login</th><th></th></tr></thead>
    <tbody>
      <% rows.forEach(u => { %>
        <tr><td><%= u.id %></td><td><%= u.account_id %></td><td class="small"><%= u.email || '—' %></td><td><%= u.role %></td>
          <td class="small"><%= new Date(u.created_at).toISOString().slice(0, 10) %></td>
          <td class="small"><%= u.last_login_at ? new Date(u.last_login_at).toISOString().slice(0, 16).replace('T', ' ') + (u.last_ip ? ' · ' + u.last_ip : '') : '—' %></td>
          <td><form class="inline" method="post" action="/admin/users/<%= u.id %>/ban"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm <%= u.banned ? '' : 'danger' %>" type="submit"><%= u.banned ? 'Unban' : 'Ban' %></button></form></td></tr>
      <% }) %>
    </tbody>
  </table></div>
  <p class="dim small">A website ban blocks website login and recharge. Ban the game account in game as well.</p>
</div></section>
<%- include('../partials/bottom') %>
