# Copy to .env (locally) or set these in Hostinger > Web App > Environment variables.

NODE_ENV=production
PORT=3000
# Public address of the site, no trailing slash
SITE_URL=https://blacklist2.com
SITE_NAME=Blacklist TS2 Online

# Coming Soon mode: true = visitors see only the landing page (admins see everything after
# logging in at /login). Set to false on launch day.
COMING_SOON=true
# Optional countdown on the Coming Soon page (ISO date with your time zone)
LAUNCH_DATE=

# Long random strings (at least 32 characters). Never reuse them elsewhere.
SESSION_SECRET=change-me-to-a-long-random-string
# Mixed into every code before it is hashed; changing it invalidates all unused codes.
CODE_PEPPER=change-me-to-another-long-random-string

# Game account IDs that get the admin panel (comma-separated). Log in once on the site first.
ADMIN_ACCOUNTS=

# Website database (Hostinger MySQL). This is NOT the game database.
DB_HOST=localhost
DB_PORT=3306
DB_USER=blacklist2web
DB_PASSWORD=
DB_NAME=blacklist2web

# Game server private API (see docs/GAME_API.md)
# mock = a fake in-memory game server for development and previews
GAME_API_MODE=mock
GAME_API_URL=https://game-api.blacklist2.com
GAME_API_SECRET=shared-secret-with-the-game-server

# GCash manual payments
GCASH_NAME=J. R.
GCASH_NUMBER=09XX XXX XXXX
# Optional: path under /public to your GCash QR image, e.g. /img/gcash-qr.png
GCASH_QR=
# Minutes a player has to pay and submit the reference number
ORDER_TTL_MINUTES=60

# Email (confirmation links). Hostinger: hPanel > Emails > create no-reply@blacklist2.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@blacklist2.com
SMTP_PASS=
MAIL_FROM=Blacklist TS2 <no-reply@blacklist2.com>

# Optional Cloudflare Turnstile captcha on register (leave empty to disable)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Links
DISCORD_URL=#
FACEBOOK_URL=#
TELEGRAM_URL=#
DOWNLOAD_PC_URL=#
DOWNLOAD_PC_MIRROR_URL=#
DOWNLOAD_ANDROID_URL=#
DOWNLOAD_ANDROID_MIRROR_URL=#
CONTACT_EMAIL=support@blacklist2.com
