{
  "name": "blacklist2web",
  "version": "0.1.0",
  "private": true,
  "description": "Website for the Blacklist TS2 Online private server: accounts, downloads, rankings, recharge and admin.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "make-admin": "node scripts/make-admin.js",
    "test": "node scripts/migrate.js && node --test --test-force-exit --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.5.0"
  },
  "overrides": {
    "mysql2": "$mysql2"
  }
}
